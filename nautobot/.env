# frisian-mcp-demo — Nautobot host.
#
# This file is COMMITTED ON PURPOSE so that `docker compose up` works on a
# fresh clone with no setup step. Every value in it is public by design — the
# demo images already ship these credentials. See .env.example for what each
# setting does and which ones are dangerous to change.

# One tag, both images. Never split these.
DEMO_TAG=v0.1.0-pre

# Loopback only. 0.0.0.0 publishes a stack with published credentials.
DEMO_BIND_HOST=127.0.0.1
DEMO_HTTP_PORT=8080

NAUTOBOT_CONFIG=/opt/nautobot/nautobot_config.py
NAUTOBOT_ALLOWED_HOSTS="localhost 127.0.0.1 [::1]"
NAUTOBOT_CREATE_SUPERUSER=false
NAUTOBOT_INSTALLATION_METRICS_ENABLED=false

# NAUTOBOT_SECRET_KEY is intentionally absent — generated per deployment on
# first boot and persisted to the demo_state volume.

# Changing this breaks every token baked into the demo database.
FRISIAN_MCP_HMAC_KEY=frisian-mcp-demo-public-hmac-key-do-not-reuse

POSTGRES_DB=nautobot
POSTGRES_USER=nautobot
POSTGRES_PASSWORD=nautobot

NAUTOBOT_DB_HOST=db
NAUTOBOT_DB_PORT=5432
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=nautobot
NAUTOBOT_DB_TIMEOUT=300

REDIS_PASSWORD=nautobot
NAUTOBOT_REDIS_HOST=redis
NAUTOBOT_REDIS_PORT=6379
NAUTOBOT_REDIS_PASSWORD=nautobot

MAX_DB_WAIT_TIME=600
DB_WAIT_TIMEOUT=5
