# ─────────────────────────────────────────────────────────────────────────────
# frisian-mcp-demo — Nautobot host — environment reference
# ─────────────────────────────────────────────────────────────────────────────
#
# YOU DO NOT NEED TO COPY THIS FILE. A working `.env` is already committed
# next to it, which is why `docker compose up` works on a fresh clone with no
# flags and no setup step. This file is the annotated reference: it documents
# every knob, including ones the committed `.env` deliberately leaves out.
#
# To change something, edit `.env` directly.
#
# NOTHING IN HERE IS A SECRET. This demo ships a pre-seeded database and
# published, publicly known credentials on purpose. Treat every value below as
# public, and never point this stack at anything real.
# ─────────────────────────────────────────────────────────────────────────────


# ── Image pinning ────────────────────────────────────────────────────────────
# ONE tag drives BOTH images:
#   ghcr.io/frisian-mcp/demo-nautobot:${DEMO_TAG}
#   ghcr.io/frisian-mcp/demo-nautobot-db:${DEMO_TAG}
#
# The database image contains a dump welded to the migration state of the app
# image built beside it. Running mismatched tags produces migration errors, so
# this is a single variable by design. Change it once; it moves both.
DEMO_TAG=v0.1.0


# ── Exposure ─────────────────────────────────────────────────────────────────
# Bound to loopback by default. The image ships known public credentials, so
# the README's safety banner is not on its own sufficient protection.
#
# Setting DEMO_BIND_HOST=0.0.0.0 publishes a demo with published credentials
# to your whole network. Only do that on a network you control.
DEMO_BIND_HOST=127.0.0.1
DEMO_HTTP_PORT=8080


# ── Nautobot ─────────────────────────────────────────────────────────────────
NAUTOBOT_CONFIG=/opt/nautobot/nautobot_config.py
NAUTOBOT_ALLOWED_HOSTS="localhost 127.0.0.1 [::1]"

# NAUTOBOT_SECRET_KEY is deliberately NOT set.
#
# The config generates a fresh SECRET_KEY on first boot and persists it to the
# `demo_state` volume, so every deployment gets its own. Setting it here would
# give every user of this repo an identical, published session-signing key.
# See FRISIAN_MCP_HMAC_KEY below for why that does not break the baked tokens.

# The demo identities are provisioned into the baked database. The upstream
# entrypoint's superuser hook is left off: it would reset the admin password
# and rewrite the admin API token on every single boot, silently overriding
# what the image was provisioned with.
#
# Turn it on only if you want a throwaway local admin, and supply all three:
#   NAUTOBOT_CREATE_SUPERUSER=true
#   NAUTOBOT_SUPERUSER_NAME=admin
#   NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
#   NAUTOBOT_SUPERUSER_PASSWORD=admin
#   NAUTOBOT_SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567
NAUTOBOT_CREATE_SUPERUSER=false


# ── frisian-mcp ──────────────────────────────────────────────────────────────
# Frisian API tokens are stored as HMAC-SHA256(raw_token, key), where the key
# is FRISIAN_MCP_HMAC_KEY falling back to SECRET_KEY.
#
# Because SECRET_KEY is generated per deployment (above), the HMAC key MUST be
# pinned to a fixed, published constant — otherwise every token baked into the
# demo database is unverifiable on first boot, and MCP auth fails with no
# useful error message.
#
# CHANGING THIS VALUE BREAKS EVERY BAKED DEMO TOKEN. It is not a secret and it
# is not supposed to be one; the tokens it protects are published in the image
# by design. The image also bakes this same value as a default so that
# deleting this line does not brick authentication.
FRISIAN_MCP_HMAC_KEY=frisian-mcp-demo-public-hmac-key-do-not-reuse


# ── Database ─────────────────────────────────────────────────────────────────
# POSTGRES_* configure the db container. NAUTOBOT_DB_* tell the app how to
# reach it. They must agree, and they must match the role the baked dump was
# created under.
POSTGRES_DB=nautobot
POSTGRES_USER=nautobot
POSTGRES_PASSWORD=nautobot

NAUTOBOT_DB_HOST=db
NAUTOBOT_DB_PORT=5432
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=nautobot
NAUTOBOT_DB_TIMEOUT=300


# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=nautobot
NAUTOBOT_REDIS_HOST=redis
NAUTOBOT_REDIS_PORT=6379
NAUTOBOT_REDIS_PASSWORD=nautobot


# ── First-boot timing ────────────────────────────────────────────────────────
# The database image restores its baked dump the first time it starts. The
# stock Nautobot entrypoint gives up waiting for the database after 30s, which
# a full-estate restore exceeds comfortably.
#
# The compose healthcheck gate is the real protection; these are the backstop.
MAX_DB_WAIT_TIME=600
DB_WAIT_TIMEOUT=5


# ── Not set here, but available ──────────────────────────────────────────────
# NAUTOBOT_UWSGI_PROCESSES=3     # uwsgi worker processes
# NAUTOBOT_LOG_LEVEL=INFO
# NAUTOBOT_INSTALLATION_METRICS_ENABLED=false
