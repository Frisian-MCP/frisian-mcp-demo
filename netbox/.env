# frisian-mcp-demo — NetBox host.
#
# This file is COMMITTED ON PURPOSE so that `docker compose up` works on a
# fresh clone with no setup step. Every value in it is public by design — the
# demo images already ship these credentials. See .env.example for what each
# setting does and which ones are dangerous to change.

# One tag, both images. Never split these.
DEMO_TAG=v0.1.0-pre

# Loopback only. 0.0.0.0 publishes a stack with published credentials.
DEMO_BIND_HOST=127.0.0.1
# 8083: 8080 is Nautobot, 8081 Paperless, 8082 Open edX.
DEMO_HTTP_PORT=8083

# Changing this breaks every token baked into the demo database.
FRISIAN_MCP_HMAC_KEY=frisian-mcp-demo-public-hmac-key-do-not-reuse

# The dump assigns ownership to the `netbox` role; db/00-assert-role.sh
# refuses to restore under any other.
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=netbox

# Space-separated, which is how the NetBox image parses it.
NETBOX_ALLOWED_HOSTS=127.0.0.1 localhost [::1]
