# frisian-mcp-demo — Paperless-ngx host.
#
# This file is COMMITTED ON PURPOSE so that `docker compose up` works on a
# fresh clone with no setup step. Every value in it is public by design — the
# demo images already ship these credentials. See .env.example for what each
# setting does and which ones are dangerous to change.

# One tag, both images. Never split these.
DEMO_TAG=v0.1.0-pre

# Loopback only. 0.0.0.0 publishes a stack with published credentials.
DEMO_BIND_HOST=127.0.0.1
# 8081, because the Nautobot demo host owns 8080 and both are meant to run
# side by side.
DEMO_HTTP_PORT=8081

# Changing this breaks every token baked into the demo database.
FRISIAN_MCP_HMAC_KEY=frisian-mcp-demo-public-hmac-key-do-not-reuse

# The dump assigns ownership to the `paperless` role; db/00-assert-role.sh
# refuses to restore under any other.
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=paperless

PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PAPERLESS_TIME_ZONE=UTC

# PAPERLESS_SECRET_KEY is intentionally absent — generated per deployment on
# first boot and persisted to the demo_state volume.
#
# PAPERLESS_ADMIN_USER is intentionally absent — the superuser is demo-admin
# and it arrives in the baked database.
