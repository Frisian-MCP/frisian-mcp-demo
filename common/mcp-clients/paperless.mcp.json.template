{
  "//": [
    "frisian-mcp demo — Paperless-ngx host.",
    "",
    "Merge the mcpServers block below into your MCP client's configuration.",
    "The tokens are real and work exactly as printed: they are fixed, published",
    "demo constants baked into the demo images, not placeholders to substitute.",
    "",
    "Three entries, because the demo IS the difference between them. Connect all",
    "three and compare what each one lists.",
    "",
    "The port is 8081. The Nautobot demo host uses 8080, so both can run at once.",
    "",
    "THE ADMIN DOOR IS /mcp/ops, NOT /mcp/admin. MCP clients strip an `admin`",
    "suffix and retry the bare URL, which lands the caller on the read-write",
    "route with the wrong tier ceiling — silently. Do not tidy the path."
  ],
  "mcpServers": {
    "paperless-read-only": {
      "type": "http",
      "url": "http://127.0.0.1:8081/mcp/read-only",
      "headers": {
        "Authorization": "Bearer frisian-demo-readonly-token-public-do-not-reuse"
      }
    },
    "paperless-read-write": {
      "type": "http",
      "url": "http://127.0.0.1:8081/mcp/read-write",
      "headers": {
        "Authorization": "Bearer frisian-demo-editor-token-public-do-not-reuse"
      }
    },
    "paperless-ops": {
      "type": "http",
      "url": "http://127.0.0.1:8081/mcp/ops",
      "headers": {
        "Authorization": "Bearer frisian-demo-admin-token-public-do-not-reuse"
      }
    }
  }
}
