# frisian-mcp-demo — Teable host.
#
# This file is COMMITTED ON PURPOSE so that `docker compose up` works on a
# fresh clone with no setup step. Every value in it is public by design — the
# demo images already ship these credentials. See .env.example for what each
# setting does and which ones are dangerous to change.

# One tag, both images. Never split these.
DEMO_TAG=v0.1.0-rc.1

# Loopback only. 0.0.0.0 publishes a stack with published credentials.
DEMO_BIND_HOST=127.0.0.1
DEMO_HTTP_PORT=3000
DEMO_DB_PORT=42345

# Postgres database
POSTGRES_DB=teable
POSTGRES_USER=teable
POSTGRES_PASSWORD=teable

# Redis cache
REDIS_PASSWORD=teable

# Teable app secret (used for JWT signing, session encryption, etc.)
SECRET_KEY=frisian-demo-teable-secret-key-do-not-reuse

# Maximum database wait time during healthcheck (seconds)
MAX_DB_WAIT_TIME=300
DB_WAIT_TIMEOUT=5
