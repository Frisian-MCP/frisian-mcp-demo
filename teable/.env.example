# frisian-mcp-demo — Teable host environment variables.
#
# This file documents every setting. Copy it to `.env` and adjust as needed,
# though the committed `.env` already works for a zero-flag boot.

# ── Image tags ─────────────────────────────────────────────────────────────
# Both images must carry the SAME tag. Splitting them is exactly the mixed
# state the lockstep pin exists to prevent.
DEMO_TAG=v0.1.0-rc.1

# ── Network binding ────────────────────────────────────────────────────────
# Host interface for published ports. Defaults to loopback.
#
# ⚠️ NEVER default to 0.0.0.0. These images ship publicly known credentials.
# Binding to all interfaces is a deliberate act by the user, never a default.
DEMO_BIND_HOST=127.0.0.1

# Host port for Teable HTTP
DEMO_HTTP_PORT=3000

# Host port for direct PostgreSQL access (used by PUBLIC_DATABASE_PROXY)
DEMO_DB_PORT=42345

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=teable
POSTGRES_USER=teable
POSTGRES_PASSWORD=teable

# ⚠️ DO NOT CHANGE POSTGRES_USER without updating db/00-assert-role.sh and
# db/provision_identities.py. The dump carries OWNER TO statements, so
# POSTGRES_USER is a hard requirement rather than a naming convention.

# Maximum time to wait for the database during healthcheck (seconds)
MAX_DB_WAIT_TIME=300
DB_WAIT_TIMEOUT=5

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=teable

# ── Application ────────────────────────────────────────────────────────────
# Secret key for JWT signing, session encryption, etc.
# ⚠️ Changing this breaks tokens baked into the demo database.
SECRET_KEY=frisian-demo-teable-secret-key-do-not-reuse

# Timezone for the application
TIMEZONE=UTC
